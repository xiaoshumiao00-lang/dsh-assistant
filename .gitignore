# 构建产物与本地依赖
node_modules/
lib/*.map

# 本地测试环境（隔离 DSH_HOME / 无头 Chrome 用户目录）
.testhome/
.chrome-test/
scripts/*.json
scripts/shot-*.png
scripts/ball.json

# 本地备份
.backup-*/

# 作者本机专用脚本（P0-6：写死作者机器的 DSH 安装路径与 app.asar 哈希，
# 不能随包发给别人；说明见 docs/作者本地脚本.md）
.author-local/
scripts/apply-desktop-*.ps1

# 本机个人化配置（正常位置在 ~/.dsh/assistant/config.json，不入库；
# 这里也挡住有人把配置文件塞进仓库根目录）
config.json
assistant-config.local.json
dsh-assistant-config.json
.testhome/**/config.json

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.log

# 鹈鹕（tihu）运行时产物：写前快照与审计日志（会话工作区里自动生成）
.tihu/

# Python 运行时缓存（asr-sensevoice）与虚拟环境，不入库
__pycache__/
*.pyc
asr-sensevoice/venv*/
asr-sensevoice/.venv*/

# Local build/runtime artifacts and backups (added 2026-11-13)
android/tools/
android/dist/
android/assistant.keystore
# 第 2 步整改 A：签名密钥与一次性口令不再放仓库内。
# 真身现在在仓库外 D:\dsh-assistant-signing\（assistant.keystore / keystore.pass），
# 下面这两条挡住任何机器把密钥或口令误塞进仓库目录。
*.keystore
keystore.pass
whisper/
.artifacts/
.tihu-preview/
tmp-serial/
out/
build-out.txt
test-out*.txt
*.bak
*.bak2
*.bak-*
dist/*.apk
/*.apk
/ESP32-S3-BOX-3-AIoT-*.pdf
/ESP32-S3-BOX-3-AIoT-*.pdf

# 上架阻断第 2 件（2026-11-28）：本机临时工作目录与构建产物一律不入库，
# 免得 git add -A 这类操作会把 .tmp/ 与 outputs/ 的证据件送进提交里。
.tmp/
outputs/
/tmp-*.png
