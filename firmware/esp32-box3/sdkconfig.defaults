# ESP32-S3-BOX-3B（ESP32-S3-WROOM-1-N16R8）
#   16 MB 四线 Flash（QIO / 80 MHz）+ 8 MB 八线(Octal) PSRAM @80 MHz
# 参考：Espressif ESP32-S3-BOX-3 / BOX-3B 用户指南「Flash & PSRAM」一节
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Flash：16 MB，80 MHz ----
# 八线(Octal) PSRAM 与 QIO flash 抢 SPI 引脚，S3 在 SPIRAM_MODE_OCT 下只允许 DIO，
# 所以这里显式写 DIO（写 QIO 会被 Kconfig 静默改回 DIO，容易看配置时误解）。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM：八线（OPI）8 MB，80 MHz，挂到 malloc 上 ----
# 注意：R8/N8R8 型号是八线 PSRAM，必须 OCT；若换到 N16R2 之类的四线板要改成 QUAD。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# LVGL 的 draw buffer 必须留在内部 RAM 做 SPI DMA（S3 的 SPI 不能 DMA 读 PSRAM），
# 2026-11-11 已把行数从 BSP 默认 100 降到 50（64 KB → 32 KB，见 main/ui.c）；
# 再加上 12 KB 的 LVGL/UI 任务栈，内部 RAM 仍偏紧，
# 打开这个开关后 WiFi/LWIP 的接收缓冲可以退到 PSRAM（官方给 S3+PSRAM 的推荐配置）。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- 分区表：自定义（partitions.csv：8 MB app + 2 MB SPIFFS+ 余量）----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- 系统 ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# esp_timer 任务在执行我们的回调：心跳要构 cJSON/发 WS、按键回调要开麦并刷 LVGL 提示条、
# 15 秒 Wi-Fi 看门狗要通知探测任务。3584 太紧（LVGL 画中文一行就要 1–2 KB），提到 6144。
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144

# LVGL 由 BSP 的 esp_lvgl_port 配置；这里只固定 16 位色，避免 RGB565 屏偏色。
CONFIG_LV_COLOR_DEPTH_16=y

# 压缩字库解压器（2026-11-11 真机「中文全是空心方框」的根因开关）。
# lv_font_conv 默认把 4bpp 位图压成 RLE 变体（生成文件里 .bitmap_format = 1）。
# 固件没开这一项时 lv_font_get_bitmap_fmt_txt() 直接返回 NULL，LVGL 就按
# 「缺字形」走 LV_USE_FONT_PLACEHOLDER，把每个字画成 1px 空心方框——看起来
# 像「字库没挂上」或「label 没设字体」，其实字库和字体都是好的。
# 现在两套字库都已改成 --no-compress（PLAIN）生成，这里再打开一次纯属保险。
CONFIG_LV_USE_FONT_COMPRESSED=y

# 串口监视器默认 115200（烧录/日志都用它，省得每次 -b）
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---- 第三方组件：i2c_bus 在 IDF 5.3 下必须退回旧 I2C 驱动 ----
# espressif/i2c_bus 1.4.x/1.5.x 在 IDF>=5.3 默认编译 i2c_bus_v2.c，其中调用了
# IDF 5.4 才有的 i2c_master_get_bus_handle()，在 v5.3 编译会报
#   error: implicit declaration of function 'i2c_master_get_bus_handle'
# 组件自带这个开关（官方注释：only valid in IDF v5.3 and above），打开即改用 driver/i2c。
# 本固件不使用 IMU/sensor_hub，BSP 自己用新 API 建 I2C 总线，因此退回旧驱动无副作用。
CONFIG_I2C_BUS_BACKWARD_CONFIG=y


# LV_FONT_FMT_TXT_LARGE: 7563 glyphs x 1.3 MB bitmap -> bitmap_index exceeds 16 bit.
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# ---- 配网页 HTTP 服务：请求头长度上限 ----
# 2026-11-11 真机「浏览器报 header fields are too long」的根因：
# esp_http_server 默认 CONFIG_HTTPD_MAX_REQ_HDR_LEN=512，请求头段塞不进这个 scratch
# 缓冲就直接回 431 Request Header Fields Too Large，正文正好是
# "Header fields are too long"。安卓 Chrome/WebView 一次普通导航的请求头
# （UA + Accept + Accept-Encoding + Accept-Language + Sec-Fetch-*）约 550–900 B，
# 必然超 512 —— 于是手机永远打不开配网页，PC 上用短头的探测请求却没事。
# 1536 B 对安卓 Chrome/微信 WebView 都够；同时把 URI 上限降到 256 B，
# 让每个请求对象（httpd_req_t 内嵌 scratch + uri）别涨太多：~1.9 KB/个，
# 配网页最多 2 个并发连接，内部 RAM 撑得住。
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536
CONFIG_HTTPD_MAX_URI_LEN=256
